# Copie para .env e ajuste se necessário

# --- Postgres (docker-compose) ---
PG_DB=honda_rag
PG_USER=honda
PG_PASSWORD=honda
PG_HOST=localhost
PG_PORT=5432

# --- LLM de chat: "ollama" (local, padrão), "claude" (Anthropic) ou "gemini" (Google) ---
# Embeddings continuam locais (bge-m3) em todos os casos. Com "claude"/"gemini", trechos do manual vão para a API.
LLM_PROVIDER=ollama
CLAUDE_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=            # defina só se LLM_PROVIDER=claude (não versionar)
GEMINI_MODEL=gemini-2.5-flash    # confira o nome do modelo na documentação do Gemini
# GEMINI_API_KEY=               # defina só se LLM_PROVIDER=gemini (não versionar)
# USE_SYSTEM_CERTS=1            # 1 (padrão): usa os certificados do Windows; 0: só o certifi
# GEMINI_THINKING_BUDGET=0      # 0 desliga o thinking (só modelos flash); vazio para modelos pro

# --- Embeddings: "ollama" (bge-m3 local, padrão) ou "gemini" (gemini-embedding-001, via API) ---
# Trocar exige recalcular os vetores: python -m honda_rag.ingest.run --stage embed
EMBED_PROVIDER=ollama
GEMINI_EMBED_MODEL=gemini-embedding-001
# MIN_COSINE=0.55              # limiar de recusa; calibrado p/ bge-m3, recalibre ao trocar o embedding

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
VLM_MODEL=qwen2.5vl:7b
EMBED_MODEL=bge-m3

# --- Tesseract ---
# Deixe vazio se 'tesseract' estiver no PATH
TESSERACT_CMD=C:\Users\joao.cardoso\AppData\Local\Tesseract-OCR\tesseract.exe

# --- Dados ---
PDF_PATH=data/raw/civic_1992-1995_service_manual.pdf
PILOT_PAGES=1-110
