# Copie para .env.prod NO SERVIDOR (chmod 600). Nunca versione o .env.prod.

# Domínio do serviço (registro A no DNS apontando para o IP da VPS)
DOMAIN=manual.seudominio.com

# --- Postgres (só rede interna do compose; troque a senha) ---
PG_DB=honda_rag
PG_USER=honda
PG_PASSWORD=troque-por-uma-senha-longa

# --- LLM de chat (a VPS não tem GPU: use uma API) ---
# LLM_PROVIDER é só o padrão: a UI (sidebar "Modelo de IA") deixa trocar, sem editar este arquivo, entre
# QUALQUER provedor abaixo que tiver chave definida aqui. O site é de acesso livre (sem login — ver
# deploy/Caddyfile): defina limite de gasto/alerta em CADA conta de API que tiver chave aqui, porque
# qualquer pessoa com o link usa o crédito de qualquer provedor configurado.
LLM_PROVIDER=gemini                  # ollama | claude | gemini | grok | hf
GEMINI_MODEL=gemini-2.5-flash        # confira o nome do modelo na documentação do Gemini
CLAUDE_MODEL=claude-haiku-4-5
GROK_MODEL=grok-4-fast               # confira o nome do modelo na documentação da xAI
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct   # confira o id do modelo no Hugging Face
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
HF_TOKEN=

# --- Embeddings: bge-m3 no Ollama do próprio compose (mesmos vetores do banco) ---
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
EMBED_KEEP_ALIVE=24h                 # mantém o modelo carregado entre perguntas

# --- Contexto da resposta (APIs aguentam mais que o 8B local) ---
CONTEXT_CHARS=24000
CONTEXT_CHUNKS=8
