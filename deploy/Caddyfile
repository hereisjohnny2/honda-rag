# Caddy: HTTPS automático (Let's Encrypt) para o domínio em $DOMAIN + login por senha na frente do app.
# O DNS do domínio precisa apontar (registro A) para o IP da VPS, com as portas 80 e 443 abertas.
{$DOMAIN} {
	encode gzip

	# usuário e hash bcrypt em auth.caddy (gerado por deploy/make_auth.sh; não versionado)
	import /etc/caddy/auth.caddy

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# o Streamlit usa WebSocket (/_stcore/stream); o reverse_proxy do Caddy já o repassa
	reverse_proxy app:8501
}
